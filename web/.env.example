# CreatorHive managed preview. Copy to .env.development.local in this directory.
# Replace the Supabase placeholders with the matching preview project's public values.
# See ../DEVELOPMENT.md for SSH tunnel and account prerequisites.
VITE_RELAY_URL=ws://localhost:3300
VITE_MANAGED_ACCOUNTS=true
VITE_SUPABASE_URL=https://YOUR_PREVIEW_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PREVIEW_PUBLISHABLE_KEY

# Opt in only after the preview backend/profile schema is ready.
VITE_PUBLIC_PROFILES=false

# Optional preview services; leave blank until configured.
# Managed keeper requests default to the relay when this is blank.
VITE_KEEPER_URL=
VITE_STAGE_URL=
VITE_LOUNGE_ROOM=
VITE_VAPID_PUBLIC_KEY=
VITE_PUSH_URL=
