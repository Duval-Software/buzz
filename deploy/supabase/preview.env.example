# Examples only. Install server secrets through protected deployment files (0600).
# Keep the old production services on their current environment until acceptance passes.
SUPABASE_URL=https://olgskffmtievlhibuhpk.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
BUZZ_MANAGED_ACCOUNTS=true
BUZZ_AUTO_MIGRATE=false
BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
BUZZ_DB_POOL_SIZE=10
# Runtime role inherits buzz_backend and has ALTER ROLE ... SET search_path=buzz,extensions.
# Use the project's CA file; direct IPv6 connection, or session pool on 5432 if needed.
DATABASE_URL=postgresql://BUZZ_RUNTIME_ROLE:URL_ENCODED_PASSWORD@db.olgskffmtievlhibuhpk.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=/etc/creatorhive/supabase-ca.crt
# Never use the transaction pool on 6543. Keep READ_DATABASE_URL unset initially.
BUZZ_MANAGED_RELAY_URL=wss://PREVIEW_CHAT_HOST
RELAY_URL=wss://PREVIEW_CHAT_HOST
BUZZ_MANAGED_HTTP_ORIGINS=https://PREVIEW_CHAT_HOST,https://PREVIEW_APP_HOST,https://PREVIEW_STAGE_HOST
# Include the preview app's exact origin in the existing relay CORS configuration.
BUZZ_IDENTITY_KEY_VERSION=1
BUZZ_IDENTITY_KEY_V1=REPLACE_WITH_64_HEX_CHARS_FROM_SECURE_RANDOM
BUZZ_SERVICE_AUTH_TOKEN=REPLACE_WITH_SEPARATE_64_HEX_CHARS_FROM_SECURE_RANDOM
# Keep BUZZ_RELAY_PRIVATE_KEY, Redis, media, and all other existing relay settings.

# web build (public values only)
VITE_MANAGED_ACCOUNTS=true
VITE_SUPABASE_URL=https://olgskffmtievlhibuhpk.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
# Preserve existing Vite relay/stage/agentkeeper origins, targeting preview services.

# glass-hive: agentkeeper and stagekeeper
CH_MANAGED_AUTH=true
CH_SESSION_VALIDATION_URL=https://PREVIEW_CHAT_HOST/api/identity/session
CH_SERVICE_AUTH_TOKEN=THE_SAME_BUZZ_SERVICE_AUTH_TOKEN
# Agentkeeper only. Use its own restricted runtime login with registry DML privileges.
AK_DATABASE_URL=postgresql://AGENTKEEPER_ROLE:URL_ENCODED_PASSWORD@db.olgskffmtievlhibuhpk.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=/etc/creatorhive/supabase-ca.crt
AK_COMMUNITY_ID=REPLACE_WITH_SEEDED_COMMUNITY_UUID
# AK_MASTER_KEY remains separately backed up; never import agents.json into this DB.

# reference app, a separate Node service behind the existing frontend reverse proxy
CREATORHIVE_CLIENT_ID=REPLACE_WITH_MANUALLY_REGISTERED_PUBLIC_OAUTH_CLIENT_UUID
CREATORHIVE_COMMUNITY_ID=REPLACE_WITH_SEEDED_COMMUNITY_UUID
SSO_ORIGIN=https://sso-demo.creatorhive.ai
PORT=8788
