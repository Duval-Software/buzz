# Database-only switch: merge these into Buzz's protected server environment.
# Keep the current relay keys, authentication, Redis and media configuration.
# Supply the password through the operator's secret store, not source control.
DATABASE_URL=postgresql://buzz_relay:URL_ENCODED_PASSWORD@db.olgskffmtievlhibuhpk.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=/etc/creatorhive/supabase-ca.crt
BUZZ_DB_POOL_SIZE=10
BUZZ_AUTO_MIGRATE=false
BUZZ_MANAGED_ACCOUNTS=false
# Unset READ_DATABASE_URL. Each connection inherits search_path=buzz,extensions
# from buzz_relay, including the separate search and audit pools.
# Direct PostgreSQL requires IPv6; if unavailable use the dashboard's SESSION
# pool endpoint on 5432, with username buzz_relay.olgskffmtievlhibuhpk.
# Never select the transaction pool on 6543.
# Leave VITE_MANAGED_ACCOUNTS and CH_MANAGED_AUTH disabled for this phase.
