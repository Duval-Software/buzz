# Canonical community URL: relay protocol + web surfaces on one hostname.
# handle blocks are mutually exclusive and evaluated in order, so the SPA's
# try_files rewrite never touches requests destined for the relay.
{$BUZZ_APP_DOMAIN} {
  encode zstd gzip

  # Device pairing (QR). Separate buzz-pair-relay service, which accepts the
  # upgrade on any path. Must precede @relay_ws, which would otherwise swallow it.
  handle /pair* {
    reverse_proxy pair-relay:5000
  }

  # Nostr relay WebSocket — the workspace itself, served from "/".
  @relay_ws {
    header Connection *Upgrade*
    header Upgrade    websocket
  }
  handle @relay_ws {
    reverse_proxy relay:3000
  }

  # NIP-11 relay info document, also on "/" via content negotiation.
  @relay_nip11 header Accept *application/nostr+json*
  handle @relay_nip11 {
    reverse_proxy relay:3000
  }

  # Relay REST surface. Disjoint from the web bundle (/, /invite/*, /repos/*).
  @relay_api path /api/* /count /deliver /events /feedback /feedback/* \
    /git/* /health /hooks/* /info /internal/* /_liveness /media/* \
    /_mesh /_mesh/* /moderation/* /query /_readiness /reports /reports/* \
    /_status /upload /.well-known/*
  handle @relay_api {
    reverse_proxy relay:3000
  }

  # Team join instructions at "/" plus its logo. Exact paths only, so the
  # SPA keeps /invite/* and /repos/*.
  @landing path / /duval.png
  handle @landing {
    root * /srv/landing
    file_server
  }

  handle {
    root * /srv/app
    try_files {path} /index.html
    file_server
  }
}

# Relay alias. Rewrites Host to the canonical name so connecting here joins the
# same community instead of spawning a second one.
{$BUZZ_DOMAIN} {
  encode zstd gzip
  reverse_proxy relay:3000 {
    header_up Host {$BUZZ_APP_DOMAIN}
  }
}
